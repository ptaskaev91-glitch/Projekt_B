{
  "name": "map-k-vercel-mirror",
  "private": true,
  "version": "2.1.1",
  "scripts": {
    "build": "node -e \"(async()=>{const u='https://api.vercel.com/v9/projects/'+process.env.VERCEL_PROJECT_ID+'?teamId='+process.env.VERCEL_ORG_ID;const r=await fetch(u,{headers:{Authorization:'Bearer '+process.env.VERCEL_OIDC_TOKEN}});const t=await r.text();let j;try{j=JSON.parse(t)}catch{};console.log('HTTP',r.status);console.log({id:j?.id,name:j?.name,link:j?.link&&{type:j.link.type,org:j.link.org,repo:j.link.repo,repoId:j.link.repoId,productionBranch:j.link.productionBranch,hasGitCredentialId:Boolean(j.link.gitCredentialId)},error:j?.error});process.exit(1)})().catch(e=>{console.error(e.message);process.exit(1)})\""
  }
}
