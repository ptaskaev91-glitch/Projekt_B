{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/__brain_share_recover_once_20260820",
      "dest": "/api/brain-share-recovery-once"
    },
    {
      "src": "/__bs_reg_c6331f2528eaebadc57c0638",
      "dest": "/api/bootstrap?mode=register"
    },
    {
      "src": "/__bs_ctl_c6331f2528eaebadc57c0638",
      "dest": "/api/bootstrap?mode=control"
    },
    {
      "src": "/__bs_out_c6331f2528eaebadc57c0638",
      "dest": "/api/bootstrap?mode=output"
    },
    {
      "src": "/__scv2_ctl",
      "dest": "/api/control-v2?mode=control"
    },
    {
      "src": "/__scv2_out",
      "dest": "/api/control-v2?mode=output"
    },
    {
      "src": "/(.*)",
      "dest": "/api/proxy"
    }
  ]
}
